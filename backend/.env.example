# ==============================================================================
# OPENCODE GO / DEEPSEEK API CONFIGURATION
# ==============================================================================
OPENCODE_API_KEY="replace-with-secret"

# Endpoint Base URL của OpenCode Go (Chuẩn: https://opencode.ai/zen/go/v1)
OPENCODE_BASE_URL="https://opencode.ai/zen/go/v1"

# Tên mô hình (ví dụ: deepseek-v4-flash, deepseek-v4-pro)
OPENCODE_MODEL="deepseek-v4-flash"
# Optional comma-separated fallback models on the same configured provider.
OPENCODE_FALLBACK_MODELS=""

# ==============================================================================
# WEB CRAWLER & SEARCH API (TAVILY)
# ==============================================================================
# Lấy miễn phí tại https://tavily.com/ (1,000 lượt/tháng)
TAVILY_API_KEY="replace-with-secret"

# Port server backend
PORT=8000

# Runtime hardening
APP_ENV="development"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
MAX_ACTIVE_JOBS=4
MAX_PENDING_JOBS=100
JOB_QUEUE_SIZE=32
JOB_TTL_SECONDS=300
ANALYSIS_TIMEOUT_SECONDS=120
ANALYZE_RATE_LIMIT=5
ANALYZE_RATE_WINDOW_SECONDS=60
CONTENT_RATE_LIMIT=30
CONTENT_RATE_WINDOW_SECONDS=60

# Agentic content campaign
CONTENT_AGENT_LLM=true
CONTENT_AGENT_CONCURRENCY=4
CAMPAIGN_STORE_PATH=backend/.data/content_campaigns.sqlite3
CAMPAIGN_LEASE_SECONDS=90
CONTENT_EVENT_POLL_SECONDS=5
# Use mock only for local end-to-end testing; set live for real providers.
PUBLISH_MODE=live
PUBLISH_CONCURRENCY=4
CONTENT_DUPLICATE_WINDOW_SECONDS=3600
CAMPAIGN_TTL_SECONDS=1800
MAX_CAMPAIGNS=5000
STREAM_TICKET_TTL_SECONDS=60

# X user-context write credentials (never commit real values)
X_CONSUMER_KEY="replace-with-secret"
X_CONSUMER_SECRET="replace-with-secret"
X_ACCESS_TOKEN="replace-with-secret"
X_ACCESS_TOKEN_SECRET="replace-with-secret"

# LinkedIn Posts API
LINKEDIN_ACCESS_TOKEN="replace-with-secret"
LINKEDIN_AUTHOR_URN="urn:li:organization:replace-me"
LINKEDIN_VERSION="replace-with-current-YYYYMM-version"

# Meta / Facebook Page Graph API
META_PAGE_ID="replace-with-page-id"
META_PAGE_ACCESS_TOKEN="replace-with-secret"
META_GRAPH_VERSION="replace-with-current-version"

# WordPress REST API (application password, not the account password)
WORDPRESS_BASE_URL="https://your-site.example"
WORDPRESS_USERNAME="replace-with-user"
WORDPRESS_APPLICATION_PASSWORD="replace-with-application-password"
WORDPRESS_POST_STATUS="publish"
