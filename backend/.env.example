# ==============================================================================
# OPENCODE GO / DEEPSEEK API CONFIGURATION
# ==============================================================================
# Điền API Key của bạn từ OpenCode Go hoặc DeepSeek
OPENCODE_API_KEY="sk-..."

# Endpoint Base URL của OpenCode Go (hoặc DeepSeek / OpenRouter)
# Ví dụ: https://api.deepseek.com/v1 hoặc endpoint riêng của OpenCode Go
OPENCODE_BASE_URL="https://api.deepseek.com/v1"

# Tên mô hình (ví dụ: deepseek-chat, deepseek-v3, deepseek-r1, deepseek-coder)
OPENCODE_MODEL="deepseek-chat"

# ==============================================================================
# WEB CRAWLER & SEARCH API (TAVILY)
# ==============================================================================
# Lấy miễn phí tại https://tavily.com/ (1,000 lượt/tháng)
TAVILY_API_KEY="tvly-..."

# Port server backend
PORT=8000
